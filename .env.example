# Copier ce fichier en `.env` et adapter les valeurs.
# Obligatoires : DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET. Les autres ont une valeur par défaut.
# Une valeur invalide fait échouer le démarrage (toutes les erreurs sont listées d'un coup).

# ─────────────────────────────────────────
# Serveur
# ─────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# development (logs lisibles, cookies sans Secure) | production (logs JSON, cookies Secure)
ENVIRONMENT=development
# Délai max (s) pour terminer les requêtes en cours à l'arrêt. Doit rester < terminationGracePeriodSeconds (k8s).
SHUTDOWN_TIMEOUT_SECS=30

# ─────────────────────────────────────────
# HTTP
# ─────────────────────────────────────────
# Origines CORS autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Durée max (s) de traitement d'une requête
REQUEST_TIMEOUT_SECS=30
# Taille max d'un corps de requête (octets)
BODY_LIMIT_BYTES=1048576
# true uniquement si l'API n'est joignable QUE via un reverse proxy :
# l'IP du client (rate limit) est alors lue dans X-Forwarded-For
TRUST_PROXY=false

# ─────────────────────────────────────────
# Rate limiting (requêtes / minute)
# ─────────────────────────────────────────
# Toute l'API, par utilisateur (ou par IP si anonyme)
RATE_LIMIT_RPM=120
# login / register / refresh, par IP
RATE_LIMIT_AUTH_RPM=10

# ─────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/app_db
DATABASE_TEST_URL=postgres://postgres:password@localhost:5433/app_test_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600
DATABASE_MAX_LIFETIME=1800

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET=change_me_with_a_strong_random_secret
JWT_EXPIRATION=86400
JWT_REFRESH_SECRET=change_me_with_another_strong_random_secret
JWT_REFRESH_EXPIRATION=604800

# ─────────────────────────────────────────
# Logs (syntaxe EnvFilter de tracing)
# ─────────────────────────────────────────
RUST_LOG=info,tower_http::trace::on_response=info,tower_http=off
